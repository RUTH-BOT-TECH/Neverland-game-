[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/orbs/flame_trial_ui.gd" id="TrialScript"]

[sub_resource type="StyleBoxFlat" id="StatusStyle"]
bg_color = Color(0.055, 0.085, 0.105, 0.86)
